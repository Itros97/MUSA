-- Fairs and markets; dates are ISO strings, so text order is date order.
CREATE TABLE event (
	id TEXT NOT NULL PRIMARY KEY,
	name TEXT NOT NULL,
	location TEXT NOT NULL,
	start_date TEXT NOT NULL,
	end_date TEXT NOT NULL,
	status TEXT NOT NULL,
	created_at INTEGER NOT NULL,
	updated_at INTEGER NOT NULL,
	deleted_at INTEGER
);

selectAll:
SELECT * FROM event WHERE deleted_at IS NULL ORDER BY status = 'CLOSED', start_date DESC, name;

selectById:
SELECT * FROM event WHERE id = ? AND deleted_at IS NULL;

upsert:
INSERT OR REPLACE INTO event(id, name, location, start_date, end_date, status, created_at, updated_at)
VALUES (?, ?, ?, ?, ?, ?, ?, ?);

updateStatus:
UPDATE event SET status = ?, updated_at = ? WHERE id = ?;

softDelete:
UPDATE event SET deleted_at = :at, updated_at = :at WHERE id = :id;

-- Development tools only: wipes the table for real, without soft deletes.
deleteAll:
DELETE FROM event;

countAll:
SELECT count(*) FROM event;
