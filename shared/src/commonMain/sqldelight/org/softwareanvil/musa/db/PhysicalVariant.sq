CREATE TABLE physical_variant (
	variant_id TEXT NOT NULL PRIMARY KEY,
	sku TEXT,
	stock INTEGER NOT NULL,
	min_stock INTEGER,
	weight_grams INTEGER,
	width_mm INTEGER,
	height_mm INTEGER,
	depth_mm INTEGER
);

CREATE INDEX physical_variant_sku ON physical_variant(sku);

upsert:
INSERT OR REPLACE INTO physical_variant(variant_id, sku, stock, min_stock, weight_grams, width_mm, height_mm, depth_mm)
VALUES (?, ?, ?, ?, ?, ?, ?, ?);

adjustStock:
UPDATE physical_variant SET stock = max(0, stock + :delta) WHERE variant_id = :variantId;

-- Uniqueness is checked here instead of with a UNIQUE index so soft-deleted rows do not block reuse.
selectSkuOwnerName:
SELECT p.name
FROM physical_variant pv
JOIN product_variant v ON v.id = pv.variant_id
JOIN product p ON p.id = v.product_id
WHERE lower(pv.sku) = lower(:sku) AND p.id != :excluding AND v.deleted_at IS NULL AND p.deleted_at IS NULL
LIMIT 1;

isPhysical:
SELECT count(*) > 0 FROM physical_variant WHERE variant_id = ?;

selectStock:
SELECT pv.stock
FROM physical_variant pv
JOIN product_variant v ON v.id = pv.variant_id
JOIN product p ON p.id = v.product_id
WHERE pv.variant_id = ? AND v.deleted_at IS NULL AND p.deleted_at IS NULL;

-- Development tools only: wipes the table for real, without soft deletes.
deleteAll:
DELETE FROM physical_variant;
