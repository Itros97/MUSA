-- Units of a physical variant moved from the catalogue to an event; sold units are counted from sale.
CREATE TABLE event_stock (
	event_id TEXT NOT NULL,
	variant_id TEXT NOT NULL,
	taken INTEGER NOT NULL,
	updated_at INTEGER NOT NULL,
	PRIMARY KEY (event_id, variant_id)
);

-- Lines with nothing taken stay as rows, so a future sync sees the change instead of a missing row.
selectByEvent:
SELECT
	es.variant_id,
	p.name AS product_name,
	v.name AS variant_name,
	v.price_cents,
	v.cost_cents,
	es.taken,
	(
		SELECT coalesce(sum(s.quantity), 0) FROM sale s
		WHERE s.event_id = es.event_id AND s.variant_id = es.variant_id AND s.deleted_at IS NULL
	) AS sold
FROM event_stock es
JOIN product_variant v ON v.id = es.variant_id
JOIN product p ON p.id = v.product_id
WHERE es.event_id = ? AND es.taken > 0
ORDER BY p.name, v.position;

selectTaken:
SELECT taken FROM event_stock WHERE event_id = ? AND variant_id = ?;

insert:
INSERT INTO event_stock(event_id, variant_id, taken, updated_at) VALUES (?, ?, ?, ?);

updateTaken:
UPDATE event_stock SET taken = :taken, updated_at = :at WHERE event_id = :eventId AND variant_id = :variantId;
