-- Price and cost per version of a product; physical stock lives in physical_variant.
CREATE TABLE product_variant (
	id TEXT NOT NULL PRIMARY KEY,
	product_id TEXT NOT NULL,
	name TEXT NOT NULL,
	price_cents INTEGER NOT NULL,
	cost_cents INTEGER NOT NULL,
	position INTEGER NOT NULL,
	updated_at INTEGER NOT NULL,
	deleted_at INTEGER
);

CREATE INDEX product_variant_product ON product_variant(product_id);

selectAll:
SELECT v.*, pv.sku, pv.stock, pv.min_stock, pv.weight_grams, pv.width_mm, pv.height_mm, pv.depth_mm
FROM product_variant v
LEFT JOIN physical_variant pv ON pv.variant_id = v.id
WHERE v.deleted_at IS NULL
ORDER BY v.position;

selectByProduct:
SELECT v.*, pv.sku, pv.stock, pv.min_stock, pv.weight_grams, pv.width_mm, pv.height_mm, pv.depth_mm
FROM product_variant v
LEFT JOIN physical_variant pv ON pv.variant_id = v.id
WHERE v.product_id = ? AND v.deleted_at IS NULL
ORDER BY v.position;

selectProductId:
SELECT product_id FROM product_variant WHERE id = ?;

exists:
SELECT count(*) FROM product_variant WHERE id = ?;

insert:
INSERT INTO product_variant(id, product_id, name, price_cents, cost_cents, position, updated_at)
VALUES (?, ?, ?, ?, ?, ?, ?);

update:
UPDATE product_variant SET name = ?, price_cents = ?, cost_cents = ?, position = ?, updated_at = ?, deleted_at = NULL
WHERE id = ?;

softDeleteMissing:
UPDATE product_variant SET deleted_at = :at, updated_at = :at
WHERE product_id = :productId AND deleted_at IS NULL AND id NOT IN :keep;

touch:
UPDATE product_variant SET updated_at = ? WHERE id = ?;

-- Development tools only: wipes the table for real, without soft deletes.
deleteAll:
DELETE FROM product_variant;
