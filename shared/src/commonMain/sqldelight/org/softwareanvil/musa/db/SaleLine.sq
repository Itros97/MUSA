-- Units of one variant in a sale; names, price and cost are copied so later product edits do not change it.
-- Lines are never edited on their own: they live and die with their sale.
CREATE TABLE sale_line (
	id TEXT NOT NULL PRIMARY KEY,
	sale_id TEXT NOT NULL,
	variant_id TEXT NOT NULL,
	product_name TEXT NOT NULL,
	variant_name TEXT NOT NULL,
	quantity INTEGER NOT NULL,
	unit_price_cents INTEGER NOT NULL,
	unit_cost_cents INTEGER NOT NULL,
	position INTEGER NOT NULL
);

CREATE INDEX sale_line_sale ON sale_line(sale_id);

selectBySales:
SELECT * FROM sale_line WHERE sale_id IN ? ORDER BY position;

insert:
INSERT INTO sale_line(id, sale_id, variant_id, product_name, variant_name, quantity, unit_price_cents, unit_cost_cents, position)
VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?);

-- Development tools only: wipes the table for real, without soft deletes.
deleteAll:
DELETE FROM sale_line;
