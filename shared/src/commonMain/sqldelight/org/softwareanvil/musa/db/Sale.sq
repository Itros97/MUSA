-- Every sale (an order), whatever the channel; its products live in sale_line.
CREATE TABLE sale (
	id TEXT NOT NULL PRIMARY KEY,
	channel TEXT NOT NULL,
	event_id TEXT,
	customer TEXT NOT NULL,
	note TEXT NOT NULL,
	shipping_charged_cents INTEGER NOT NULL,
	shipping_cost_cents INTEGER NOT NULL,
	sold_at INTEGER NOT NULL,
	updated_at INTEGER NOT NULL,
	deleted_at INTEGER
);

CREATE INDEX sale_event ON sale(event_id);

selectAll:
SELECT * FROM sale WHERE deleted_at IS NULL ORDER BY sold_at DESC;

selectByEvent:
SELECT * FROM sale WHERE event_id = ? AND deleted_at IS NULL ORDER BY sold_at DESC;

selectById:
SELECT * FROM sale WHERE id = ? AND deleted_at IS NULL;

insert:
INSERT INTO sale(id, channel, event_id, customer, note, shipping_charged_cents, shipping_cost_cents, sold_at, updated_at)
VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?);

softDelete:
UPDATE sale SET deleted_at = :at, updated_at = :at WHERE id = :id;

-- Development tools only: wipes the table for real, without soft deletes.
deleteAll:
DELETE FROM sale;
