-- What attending an event cost: stand, travel, lodging...
CREATE TABLE event_expense (
	id TEXT NOT NULL PRIMARY KEY,
	event_id TEXT NOT NULL,
	concept TEXT NOT NULL,
	amount_cents INTEGER NOT NULL,
	created_at INTEGER NOT NULL,
	updated_at INTEGER NOT NULL,
	deleted_at INTEGER
);

CREATE INDEX event_expense_event ON event_expense(event_id);

selectByEvent:
SELECT * FROM event_expense WHERE event_id = ? AND deleted_at IS NULL ORDER BY created_at;

insert:
INSERT INTO event_expense(id, event_id, concept, amount_cents, created_at, updated_at) VALUES (?, ?, ?, ?, ?, ?);

softDelete:
UPDATE event_expense SET deleted_at = :at, updated_at = :at WHERE id = :id;

-- Development tools only: wipes the table for real, without soft deletes.
deleteAll:
DELETE FROM event_expense;
