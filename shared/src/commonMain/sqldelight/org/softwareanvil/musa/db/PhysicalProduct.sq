CREATE TABLE physical_product (
	product_id TEXT NOT NULL PRIMARY KEY,
	material TEXT NOT NULL
);

selectAll:
SELECT * FROM physical_product;

selectByProduct:
SELECT * FROM physical_product WHERE product_id = ?;

upsert:
INSERT OR REPLACE INTO physical_product(product_id, material) VALUES (?, ?);

-- Development tools only: wipes the table for real, without soft deletes.
deleteAll:
DELETE FROM physical_product;
