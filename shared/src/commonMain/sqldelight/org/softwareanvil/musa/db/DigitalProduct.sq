CREATE TABLE digital_product (
	product_id TEXT NOT NULL PRIMARY KEY,
	delivery_format TEXT NOT NULL,
	turnaround_days INTEGER
);

selectAll:
SELECT * FROM digital_product;

selectByProduct:
SELECT * FROM digital_product WHERE product_id = ?;

upsert:
INSERT OR REPLACE INTO digital_product(product_id, delivery_format, turnaround_days) VALUES (?, ?, ?);

-- Development tools only: wipes the table for real, without soft deletes.
deleteAll:
DELETE FROM digital_product;
