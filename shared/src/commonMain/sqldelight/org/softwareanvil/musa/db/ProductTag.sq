CREATE TABLE product_tag (
	product_id TEXT NOT NULL,
	tag_id TEXT NOT NULL,
	position INTEGER NOT NULL,
	PRIMARY KEY (product_id, tag_id)
);

selectAll:
SELECT pt.product_id, t.*
FROM product_tag pt
JOIN tag t ON t.id = pt.tag_id
WHERE t.deleted_at IS NULL
ORDER BY pt.position;

selectByProduct:
SELECT t.*
FROM product_tag pt
JOIN tag t ON t.id = pt.tag_id
WHERE pt.product_id = ? AND t.deleted_at IS NULL
ORDER BY pt.position;

deleteByProduct:
DELETE FROM product_tag WHERE product_id = ?;

insert:
INSERT INTO product_tag(product_id, tag_id, position) VALUES (?, ?, ?);

-- Development tools only: wipes the table for real, without soft deletes.
deleteAll:
DELETE FROM product_tag;
