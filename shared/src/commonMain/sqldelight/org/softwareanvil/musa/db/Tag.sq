-- normalized_name is the folded name ("pokemon") that makes spelling variants the same tag.
CREATE TABLE tag (
	id TEXT NOT NULL PRIMARY KEY,
	name TEXT NOT NULL,
	normalized_name TEXT NOT NULL UNIQUE,
	color TEXT NOT NULL,
	created_at INTEGER NOT NULL,
	updated_at INTEGER NOT NULL,
	deleted_at INTEGER
);

selectAll:
SELECT * FROM tag WHERE deleted_at IS NULL ORDER BY normalized_name;

selectByKey:
SELECT * FROM tag WHERE normalized_name = ? AND deleted_at IS NULL;

insert:
INSERT INTO tag(id, name, normalized_name, color, created_at, updated_at) VALUES (?, ?, ?, ?, ?, ?);
