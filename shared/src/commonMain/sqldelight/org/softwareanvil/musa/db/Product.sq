-- Fields shared by every product; kind-specific data lives in physical_product / digital_product.
CREATE TABLE product (
	id TEXT NOT NULL PRIMARY KEY,
	kind TEXT NOT NULL,
	name TEXT NOT NULL,
	description TEXT NOT NULL,
	status TEXT NOT NULL,
	created_at INTEGER NOT NULL,
	updated_at INTEGER NOT NULL,
	deleted_at INTEGER
);

selectAll:
SELECT * FROM product WHERE deleted_at IS NULL;

selectById:
SELECT * FROM product WHERE id = ? AND deleted_at IS NULL;

exists:
SELECT count(*) FROM product WHERE id = ?;

insert:
INSERT INTO product(id, kind, name, description, status, created_at, updated_at)
VALUES (?, ?, ?, ?, ?, ?, ?);

update:
UPDATE product SET name = ?, description = ?, status = ?, updated_at = ? WHERE id = ?;

updateStatus:
UPDATE product SET status = ?, updated_at = ? WHERE id = ?;

touch:
UPDATE product SET updated_at = ? WHERE id = ?;

softDelete:
UPDATE product SET deleted_at = ?, updated_at = ? WHERE id = ?;

-- Development tools only: wipes the table for real, without soft deletes.
deleteAll:
DELETE FROM product;

countAll:
SELECT count(*) FROM product;
